# OpenAI API 키는 .env 파일에만 설정하고 Git에 커밋하지 않습니다.
OPENAI_API_KEY=your_api_key_here
# JSON 응답 형식을 지원하는 OpenAI 모델을 지정합니다.
OPENAI_MODEL=gpt-4.1-mini
# 이 값을 기준으로 긴 문서를 분할해 OpenAI에 전달합니다.
MAX_LLM_INPUT_CHARS=30000
# 긴 문서의 인접 문맥을 보존하기 위해 각 분할 구간에 중복 포함할 문자 수입니다.
CHUNK_OVERLAP_CHARS=500
# 1억 자 이내 문서라도 과도한 API 호출을 막기 위한 최대 분할 수입니다.
MAX_ANALYSIS_CHUNKS=4000
# Windows에서 Uvicorn이 Tesseract PATH를 상속하지 못할 때 아래 경로를 지정합니다.
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
# TESSDATA_DIR=C:\\Users\\your-user\\AppData\\Local\\Tesseract-OCR\\tessdata
